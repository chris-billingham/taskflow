{
  "name": "taskflow",
  "version": "1.0.2",
  "private": true,
  "description": "Self-hosted task management application",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @taskflow/api test:integration",
    "test:e2e": "pnpm --filter @taskflow/e2e test",
    "test:coverage": "turbo run test:coverage",
    "test:ci": "turbo run test:unit && pnpm --filter @taskflow/api test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.2.4",
    "turbo": "^2.11.6",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "msw"
    ],
    "overrides": {
      "@prisma/config>deepmerge-ts": "8.0.2",
      "prisma>mysql2": "^3.23.1"
    }
  }
}
