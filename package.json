{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted task management application",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @taskflow/api test:integration",
    "test:e2e": "pnpm --filter @taskflow/e2e test",
    "test:coverage": "turbo run test:coverage",
    "test:ci": "turbo run test:unit && pnpm --filter @taskflow/api test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.7.0",
    "prettier": "^3.2.4",
    "turbo": "^1.12.4",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "socket.io-parser": "^4.2.6",
      "bn.js@<4.12.3": ">=4.12.3",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "file-type@>=13.0.0 <21.3.1": ">=21.3.1",
      "fast-uri@<=3.1.0": ">=3.1.1",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "engine.io@>=4.1.0 <6.6.7": ">=6.6.7",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4",
      "fast-uri@>=3.0.0 <3.1.3": ">=3.1.3",
      "find-my-way@<=9.6.0": ">=9.7.0",
      "@fastify/static@<=10.1.1": ">=10.1.2",
      "@fastify/static@<=10.1.0": ">=10.1.1",
      "brace-expansion@<1.1.16": "^1.1.16",
      "brace-expansion@>=5.0.0 <5.0.8": "^5.0.8"
    }
  }
}
