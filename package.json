{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted task management application",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @taskflow/api test:integration",
    "test:e2e": "pnpm --filter @taskflow/e2e test",
    "test:coverage": "turbo run test:coverage",
    "test:ci": "turbo run test:unit && pnpm --filter @taskflow/api test:integration"
  },
  "devDependencies": {
    "prettier": "^3.2.4",
    "turbo": "^1.12.4"
  },
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
