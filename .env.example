# ============================================================
# Taskflow Environment Configuration
# Copy to .env and fill in values before running install.sh
# ============================================================

# === Domain & SSL (production) ===
DOMAIN=taskflow.example.com
# Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@example.com

# === PostgreSQL ===
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=taskflow
# Full connection string (auto-composed by docker-compose in production)
DATABASE_URL="postgresql://taskflow:change-me-strong-password@localhost:5432/taskflow"

# === Redis ===
REDIS_PASSWORD=change-me-strong-password
REDIS_URL="redis://:change-me-strong-password@localhost:6379"

# === JWT Secrets (generate with: openssl rand -hex 32) ===
JWT_SECRET=change-me-to-random-64-char-hex-string-minimum-32-chars
JWT_REFRESH_SECRET=change-me-to-different-random-64-char-hex-string

# === Object storage (bundled Garage, S3-compatible) ===
# docker-compose.yml creates this key and bucket in Garage on first start and
# gives the same values to the API. scripts/install.sh generates all three.
# Garage's key format is strict:
#   S3_ACCESS_KEY  "GK" followed by 24 hex characters  (GK + openssl rand -hex 12)
#   S3_SECRET_KEY  64 hex characters                    (openssl rand -hex 32)
S3_ACCESS_KEY=GK-change-me
S3_SECRET_KEY=change-me
S3_BUCKET=taskflow
# Garage's internal RPC secret: 64 hex characters (openssl rand -hex 32).
GARAGE_RPC_SECRET=change-me

# === Sign-ups ===
# invite (default): the first account, ADMIN_EMAILS addresses and people with a
# pending workspace invite can sign up; admins add everyone else from the
# console. open: anyone who can reach the site can sign up. Admins can switch
# this in the console later; their choice then overrides this value.
REGISTRATION_MODE=invite

# === Instance administrators ===
# Comma-separated addresses that should hold the instance-level ADMIN role.
# Admins manage ACCOUNTS deployment-wide (create, suspend, reset passwords,
# delete). They get no extra access to other people's tasks or projects.
#
# Promote-only and idempotent:
#   - a listed address that registers is created as an admin immediately
#   - a listed address that already has an account is promoted at API startup
#   - nothing here ever demotes, reactivates or deletes an account
# This is also the break-glass path if admin access is ever lost.
ADMIN_EMAILS=admin@example.com

# === API Configuration ===
API_PORT=3001
NODE_ENV=production
LOG_LEVEL=info
# Both of these are derived from DOMAIN by docker-compose.yml, so leave them
# alone unless you serve the app from somewhere other than https://$DOMAIN.
# Setting APP_URL here OVERRIDES that default — a stale value left at the example
# domain would send every password-reset and invite link to example.com.
CORS_ORIGIN=https://taskflow.example.com
# APP_URL=https://taskflow.example.com
MAX_FILE_SIZE_MB=25

# Proxy hops between the client and the API. 1 = the shipped topology
# (client → Traefik → API). Add one for each extra proxy you put in front,
# e.g. a CDN. This decides which address rate limits are counted against:
# too low and everyone shares one bucket, too high and clients can forge
# X-Forwarded-For to get a fresh bucket per request.
TRUST_PROXY_HOPS=1

# Networks a proxy hop must come from before its X-Forwarded-For is believed
# (comma-separated proxy-addr names, IPs or CIDRs). The default covers Docker
# bridge networks, so it works with the shipped Traefik; narrow it to your
# Traefik network's CIDR (`docker network inspect traefik`) if you can.
TRUST_PROXY_ADDRS=loopback,linklocal,uniquelocal

# Multiplies every rate limit (login 5 per 15 minutes, registration 5 per hour,
# 300 requests per minute overall, ...). Limits count per client IP, so if your
# whole team connects from one office IP, raise this (e.g. 5). Minimum 1.
RATE_LIMIT_MULTIPLIER=1

# Serve the Swagger UI at /api/docs (an inventory of every endpoint).
# ENABLE_API_DOCS=true

# === Single sign-on (OpenID Connect) ===
# Authentik, Keycloak, Google Workspace and others. Register Taskflow with the
# provider using the redirect URI https://<your domain>/api/v1/auth/oidc/callback.
# See docs/admin-guide/single-sign-on.md.
# OIDC_ISSUER=https://auth.example.com/application/o/taskflow/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# The button reads "Sign in with <OIDC_NAME>".
# OIDC_NAME=Authentik
# OIDC_TRUST_EMAIL=false

# === Webhooks ===
# Let webhooks reach private and local addresses, such as an n8n on your
# network. Off by default, so project admins can't use webhooks to probe the
# network the server is on.
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# === History ===
# Days of activity and notifications to keep (0 = forever). Unread
# notifications are kept four times as long as read ones.
# ACTIVITY_RETENTION_DAYS=365
# NOTIFICATION_RETENTION_DAYS=90

# === Monitoring ===
# Require this as a Bearer token on GET /metrics (Prometheus). /metrics is only
# reachable inside the Docker networks either way. At least 16 characters.
# METRICS_TOKEN=

# === Release ===
# The Taskflow release to run, e.g. 1.2.0. install.sh and upgrade.sh set it;
# `local` means images built from this checkout (upgrade.sh --build).
TASKFLOW_VERSION=
# Where release images come from (taskflow-api and taskflow-web). Change it
# only if you publish your own builds.
# TASKFLOW_REGISTRY=ghcr.io/chris-billingham

# === Backups ===
# Encrypts the .env copy inside each backup archive. WITHOUT this it is stored
# in plaintext, so every archive contains your database, Redis and JWT secrets.
# BACKUP_PASSPHRASE=
# Upload each archive here after creation (requires the aws CLI on the host).
# BACKUP_S3_BUCKET=

# === SMTP (optional — enables email notifications) ===
# Without SMTP there is no self-service password reset: recovery is an admin
# resetting the password from the console. Set ADMIN_EMAILS above regardless.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Required whenever SMTP_HOST is set. Use a domain that actually resolves —
# mail from an unroutable address (.local) is rejected by most receivers.
# SMTP_FROM=noreply@example.com

# Web Push notifications (optional). Generate a key pair with:
#   docker compose -f docker-compose.yml run --rm api npx web-push generate-vapid-keys
# Push stays disabled until both keys are set.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Required whenever the keys above are set.
# VAPID_SUBJECT=mailto:admin@your-domain.example.com

# Apple push notifications for the iOS app (optional): an APNs .p8 key from
# the Apple Developer account. All four are needed.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_BUNDLE_ID=
