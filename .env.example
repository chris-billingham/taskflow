# ============================================================
# Taskflow Environment Configuration
# Copy to .env and fill in values before running install.sh
# ============================================================

# === Domain & SSL (production) ===
DOMAIN=taskflow.example.com
# Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@example.com

# === PostgreSQL ===
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=taskflow
# Full connection string (auto-composed by docker-compose in production)
DATABASE_URL="postgresql://taskflow:change-me-strong-password@localhost:5432/taskflow"

# === Redis ===
REDIS_PASSWORD=change-me-strong-password
REDIS_URL="redis://:change-me-strong-password@localhost:6379"

# === JWT Secrets (generate with: openssl rand -hex 32) ===
JWT_SECRET=change-me-to-random-64-char-hex-string-minimum-32-chars
JWT_REFRESH_SECRET=change-me-to-different-random-64-char-hex-string

# === MinIO / S3 Object Storage ===
MINIO_ROOT_USER=taskflow-admin
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_BUCKET=taskflow
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=taskflow
S3_REGION=us-east-1
S3_ACCESS_KEY=taskflow-admin
S3_SECRET_KEY=change-me-strong-password

# === Instance administrators ===
# Comma-separated addresses that should hold the instance-level ADMIN role.
# Admins manage ACCOUNTS deployment-wide (create, suspend, reset passwords,
# delete). They get no extra access to other people's tasks or projects.
#
# Promote-only and idempotent:
#   - a listed address that registers is created as an admin immediately
#   - a listed address that already has an account is promoted at API startup
#   - nothing here ever demotes, reactivates or deletes an account
# This is also the break-glass path if admin access is ever lost.
ADMIN_EMAILS=admin@example.com

# === API Configuration ===
API_PORT=3001
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=https://taskflow.example.com
MAX_FILE_SIZE_MB=25

# === Docker Images ===
# Set DOCKER_REGISTRY to push/pull from a registry (e.g. ghcr.io/your-org)
DOCKER_REGISTRY=taskflow
IMAGE_TAG=latest

# === SMTP (optional — enables email notifications) ===
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Web Push notifications (optional). Generate a key pair with:
#   docker compose -f docker-compose.yml run --rm api npx web-push generate-vapid-keys
# Push stays disabled until both keys are set.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-domain.example.com
