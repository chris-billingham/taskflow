# Local development configuration for the API and the worker.
#
#   cp packages/api/.env.example packages/api/.env
#
# This file — NOT the repo-root .env — is what `pnpm --filter @taskflow/api dev`
# reads: its `--env-file=.env` resolves against the package directory, and the
# Prisma CLI likewise looks for .env in the directory it runs in. The root
# .env.example is the PRODUCTION template consumed by docker-compose, and copying
# that one here sets NODE_ENV=production, which turns on secure-only cookies and
# breaks sign-in over plain http://localhost.
#
# The defaults below match docker-compose.dev.yml, so no edits are needed.

DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow"
REDIS_URL="redis://localhost:6379"

# Dev-only values. Production secrets are generated by scripts/install.sh.
JWT_SECRET="dev-jwt-secret-change-me-in-production-min32chars"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-change-me-in-prod-min32ch"

CORS_ORIGIN="http://localhost:31779"
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# S3 / MinIO file storage. Outside production these two fall back to the
# docker-compose.dev.yml credentials, so they are optional here.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=taskflow
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MAX_FILE_SIZE_MB=25

# Required by packages/e2e/tests/admin.spec.ts, which registers this address and
# asserts it comes out an instance administrator.
ADMIN_EMAILS=e2e-admin@taskflow.test

# Web push (optional). Generate a pair with:
#   pnpm --filter @taskflow/api exec npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:dev@example.com

# SMTP (optional). Unset means email features are disabled and new accounts are
# auto-verified. Point it at a local catcher (Mailpit, MailHog) to exercise them.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=dev@example.com

# Prisma query logging includes bound parameter values (password and token
# hashes) — opt in only while debugging.
# PRISMA_QUERY_LOG=true
