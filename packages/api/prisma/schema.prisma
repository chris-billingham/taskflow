generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

// Instance-wide role, deliberately separate from WorkspaceRole/ProjectRole:
// those govern access WITHIN a workspace or project, this one governs the
// deployment itself (account lifecycle). A SystemRole.ADMIN is not implicitly
// a member of anyone's workspace and gets no extra access to their content.
enum SystemRole {
  USER
  ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ProjectRole {
  ADMIN
  MEMBER
  COMMENTER
  VIEWER
}

enum ViewStyle {
  LIST
  BOARD
  CALENDAR
}

enum ReminderType {
  ABSOLUTE
  RELATIVE
}

enum ReminderMethod {
  PUSH
  EMAIL
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  COMPLETED
  UNCOMPLETED
  MOVED
  ASSIGNED
  UNASSIGNED
  COMMENTED
  ARCHIVED
  UNARCHIVED
  SHARED
}

enum EntityType {
  TASK
  PROJECT
  SECTION
  COMMENT
  LABEL
  WORKSPACE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  COMMENT_ON_TASK
  MENTION_IN_COMMENT
  PROJECT_SHARED
  WORKSPACE_INVITE
  REMINDER
}

// Display preferences. The database stores the format strings the clients
// use (@map); the API contract translates the names back to them.
enum DateFormat {
  MONTH_NAME  @map("MMM d, yyyy")
  MONTH_FIRST @map("MM/dd/yyyy")
  DAY_FIRST   @map("dd/MM/yyyy")
  ISO         @map("yyyy-MM-dd")
}

enum TimeFormat {
  H12 @map("12h")
  H24 @map("24h")
}

enum Theme {
  light
  dark
  system
}

enum EmailFrequency {
  immediate
  daily
  weekly
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  avatarUrl        String?
  timezone         String    @default("UTC")
  weekStart        Int       @default(0) // 0 = Sunday, 6 = Saturday
  dateFormat       DateFormat?
  timeFormat       TimeFormat?
  theme            Theme?
  // Instance-level role. Admins manage accounts deployment-wide; see SystemRole.
  role             SystemRole @default(USER)
  // Suspended accounts keep all their data but cannot log in or refresh a
  // session. Deactivating is the reversible alternative to deletion.
  isActive         Boolean   @default(true)
  emailVerified    Boolean   @default(false)
  // sha256 hex of the raw token (the raw value is only ever in the email link)
  emailVerifyToken          String?   @unique
  emailVerifyTokenExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?
  // Two-factor sign-in (TOTP). The secret is stored during setup and takes
  // effect once twoFactorEnabledAt is set. totpLastStep is the time step of
  // the last code accepted, so the same code can't be used twice.
  totpSecret         String?
  twoFactorEnabledAt DateTime?
  totpLastStep       Int?

  // Relations
  refreshTokens     RefreshToken[]
  apiTokens         ApiToken[]
  recoveryCodes     RecoveryCode[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  ownedProjects     Project[]         @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  createdTasks      Task[]            @relation("TaskCreator")
  assignedTasks     Task[]            @relation("TaskAssignee")
  labels            Label[]
  filters           Filter[]
  comments          Comment[]
  reminders         Reminder[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  appleDevices      AppleDevice[]
  notificationPreference NotificationPreference?
  attachments       Attachment[]      @relation("AttachmentUploader")
  templates         Template[]
  activityLogs      ActivityLog[]
  projectSettings   ProjectUserSetting[]
  sectionSettings   SectionUserSetting[]
  labelSettings     LabelUserSetting[]

  @@index([email])
  // The admin console filters on both; also backs the "is there another
  // active admin left?" guard that runs before every demote/suspend/delete.
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ─── RefreshToken ───────────────────────────────────────────────────────────

enum SessionClient {
  WEB
  APP
}

// One signed-in device. Each refresh replaces the row (rotation) but keeps
// the sessionId, name and start time, so a session can be listed and revoked.
model RefreshToken {
  id               String        @id @default(cuid())
  // sha256 hex of the raw token — never the replayable value itself
  token            String        @unique
  userId           String
  sessionId        String
  // What the person sees in their sessions list: "iPhone", "Firefox on Windows".
  name             String?
  client           SessionClient @default(WEB)
  // The user agent, for telling similar devices apart.
  deviceInfo       String?
  sessionStartedAt DateTime      @default(now())
  lastUsedAt       DateTime      @default(now())
  expiresAt        DateTime
  createdAt        DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

enum ApiTokenScope {
  READ
  WRITE
}

// A personal access token for scripts and integrations. Only its hash is
// stored; the token itself is shown once, when it's created.
model ApiToken {
  id         String        @id @default(cuid())
  userId     String
  name       String
  tokenHash  String        @unique
  // The start of the token ("tfp_ab12"), so people can tell tokens apart.
  prefix     String
  scope      ApiTokenScope
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

// One-time codes for signing in when the authenticator app isn't available.
// Stored as sha256 (they're random, not passwords); each works once.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

// ─── Workspace ──────────────────────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  avatarUrl   String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict: a user cannot be deleted while they still own a workspace —
  // cascading here destroyed every member's projects/tasks/comments.
  // deleteUser() removes sole-member workspaces first and requires ownership
  // transfer for shared ones.
  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members WorkspaceMember[]
  invites WorkspaceInvite[]
  projects Project[]
  labels  Label[]
  templates Template[]      @relation("WorkspaceTemplates")

  @@index([ownerId])
  @@index([slug])
  @@map("workspaces")
}

// ─── WorkspaceMember ────────────────────────────────────────────────────────

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  // The transaction that last wrote the row (trigger); what /sync filters on.
  syncTxid  BigInt @default(dbgenerated("txid_current()"))

  @@index([syncTxid])
  @@map("workspace_members")
}

// ─── WorkspaceInvite ────────────────────────────────────────────────────────

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@map("workspace_invites")
}

// ─── Project ────────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(cuid())
  name        String
  color       String    @default("#3B82F6")
  description String?
  ownerId     String?
  workspaceId String?
  parentId    String?
  viewStyle   ViewStyle @default(LIST)
  isArchived  Boolean   @default(false)
  isInbox     Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner     User?           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  workspace Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Project?        @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Project[]       @relation("ProjectHierarchy")
  members   ProjectMember[]
  sections  Section[]
  tasks     Task[]
  userSettings ProjectUserSetting[]

  @@index([ownerId])
  @@index([workspaceId])
  @@index([parentId])
  // Bumped on every change (trigger). Clients send it back as ifVersion so a
  // stale edit is refused instead of overwriting a newer one.
  version   Int    @default(1)
  // The transaction that last wrote the row (trigger); what /sync filters on.
  syncTxid  BigInt @default(dbgenerated("txid_current()"))

  @@index([syncTxid])
  @@map("projects")
}

// ─── ProjectMember ──────────────────────────────────────────────────────────

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  addedAt   DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  // The transaction that last wrote the row (trigger); what /sync filters on.
  syncTxid  BigInt @default(dbgenerated("txid_current()"))

  @@index([syncTxid])
  @@map("project_members")
}

// ─── Section ────────────────────────────────────────────────────────────────

model Section {
  id          String   @id @default(cuid())
  name        String
  projectId   String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  userSettings SectionUserSetting[]

  @@index([projectId])
  // Bumped on every change (trigger). Clients send it back as ifVersion so a
  // stale edit is refused instead of overwriting a newer one.
  version   Int    @default(1)
  // The transaction that last wrote the row (trigger); what /sync filters on.
  syncTxid  BigInt @default(dbgenerated("txid_current()"))

  @@index([syncTxid])
  @@map("sections")
}

// ─── Per-user settings ──────────────────────────────────────────────────────

// How one person arranges a project they can see. These used to be columns on
// the shared project row, so favouriting or reordering a team project did it
// for everyone.
model ProjectUserSetting {
  userId     String
  projectId  String
  isFavorite Boolean  @default(false)
  // Null until this person reorders; the project's own sortOrder applies.
  sortOrder  Int?
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
  // The transaction that last wrote the row (trigger); what /sync filters on.
  syncTxid  BigInt @default(dbgenerated("txid_current()"))

  @@index([syncTxid])
  @@map("project_user_settings")
}

// Whether one person has a section collapsed.
model SectionUserSetting {
  userId      String
  sectionId   String
  isCollapsed Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId])
  @@index([sectionId])
  // The transaction that last wrote the row (trigger); what /sync filters on.
  syncTxid  BigInt @default(dbgenerated("txid_current()"))

  @@index([syncTxid])
  @@map("section_user_settings")
}

// ─── Task ───────────────────────────────────────────────────────────────────

model Task {
  id             String    @id @default(cuid())
  content        String
  description    String?
  projectId      String
  sectionId      String?
  parentId       String?
  // Nullable: tasks outlive their creator (SetNull) — cascading here deleted
  // team tasks from shared projects when their creator left.
  creatorId      String?
  assigneeId     String?
  // Calendar days, not instants: "due on 27 Sep" means that day wherever the
  // user is. dueTime (HH:mm) is a wall-clock time in the user's timezone.
  dueDate        DateTime? @db.Date
  dueTime        String?   // HH:mm format
  deadline       DateTime? @db.Date
  duration       Int?      // in minutes
  isRecurring    Boolean   @default(false)
  recurrenceRule String?   // RRULE string
  priority       Int       @default(4) // 1 = highest, 4 = lowest
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  // Fractional: placing a task between two others takes the midpoint, so
  // moving one task updates one row (POST /tasks/:id/position).
  sortOrder      Float     @default(0)
  // Set when the task is moved to the trash; the maintenance job deletes it
  // for good after 30 days. Reads exclude trashed tasks (config/database.ts).
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent     Task?       @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks   Task[]      @relation("TaskSubtasks")
  creator    User?       @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignee   User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  taskLabels TaskLabel[]
  comments   Comment[]   @relation("TaskComments")
  reminders  Reminder[]
  attachments Attachment[] @relation("TaskAttachments")
  activityLogs ActivityLog[]

  // Composite matches the hot list query (WHERE projectId ORDER BY sortOrder)
  @@index([projectId, sortOrder])
  @@index([sectionId])
  @@index([parentId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([isCompleted])
  @@index([priority])
  @@index([deletedAt])
  // Bumped on every change (trigger). Clients send it back as ifVersion so a
  // stale edit is refused instead of overwriting a newer one.
  version   Int    @default(1)
  // The transaction that last wrote the row (trigger); what /sync filters on.
  syncTxid  BigInt @default(dbgenerated("txid_current()"))

  @@index([syncTxid])
  @@map("tasks")
}

// ─── Label ──────────────────────────────────────────────────────────────────

// A label belongs to one space: a person's own (userId) or a workspace's
// (workspaceId) — exactly one is set (CHECK labels_one_owner). A task can
// only carry labels from its project's space, so everyone on a team project
// uses the same labels.
model Label {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#6B7280")
  userId      String?
  workspaceId String?
  // The default order, for people who haven't arranged their labels.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskLabels   TaskLabel[]
  userSettings LabelUserSetting[]

  @@unique([userId, name])
  @@unique([workspaceId, name])
  @@index([userId])
  @@index([workspaceId])
  // Bumped on every change (trigger). Clients send it back as ifVersion so a
  // stale edit is refused instead of overwriting a newer one.
  version   Int    @default(1)
  // The transaction that last wrote the row (trigger); what /sync filters on.
  syncTxid  BigInt @default(dbgenerated("txid_current()"))

  @@index([syncTxid])
  @@map("labels")
}

// How one person arranges a label they can see.
model LabelUserSetting {
  userId     String
  labelId    String
  isFavorite Boolean  @default(false)
  sortOrder  Int?
  updatedAt  DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([userId, labelId])
  @@index([labelId])
  // The transaction that last wrote the row (trigger); what /sync filters on.
  syncTxid  BigInt @default(dbgenerated("txid_current()"))

  @@index([syncTxid])
  @@map("label_user_settings")
}

// ─── TaskLabel (join table) ─────────────────────────────────────────────────

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
  @@map("task_labels")
}

// ─── Filter ─────────────────────────────────────────────────────────────────

model Filter {
  id        String    @id @default(cuid())
  name      String
  query     String
  color     String    @default("#6B7280")
  userId    String
  isFavorite Boolean  @default(false)
  sortOrder Int       @default(0)
  viewStyle ViewStyle @default(LIST)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("filters")
}

// ─── Comment ────────────────────────────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  content   String   // markdown
  authorId  String
  taskId    String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  task        Task?      @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)
  parent      Comment?   @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]  @relation("CommentThread")
  attachments Attachment[] @relation("CommentAttachments")

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

// ─── Reminder ───────────────────────────────────────────────────────────────

model Reminder {
  id            String         @id @default(cuid())
  taskId        String
  userId        String
  type          ReminderType
  triggerAt     DateTime?      // for ABSOLUTE
  minutesBefore Int?           // for RELATIVE
  method        ReminderMethod @default(PUSH)
  isSent        Boolean        @default(false)
  sentAt        DateTime?
  // Failed delivery attempts; retried up to a cap instead of every 60s forever
  attempts      Int            @default(0)
  createdAt     DateTime       @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  // Composite index matches the due-reminder poll (WHERE isSent = false AND triggerAt <= now)
  @@index([isSent, triggerAt])
  @@map("reminders")
}

// ─── Attachment ─────────────────────────────────────────────────────────────

model Attachment {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String
  size         Int
  url          String
  taskId       String?
  commentId    String?
  uploadedById String
  createdAt    DateTime @default(now())

  task       Task?    @relation("TaskAttachments", fields: [taskId], references: [id], onDelete: SetNull)
  comment    Comment? @relation("CommentAttachments", fields: [commentId], references: [id], onDelete: SetNull)
  uploadedBy User     @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([commentId])
  @@index([uploadedById])
  @@map("attachments")
}

// ─── Template ───────────────────────────────────────────────────────────────

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  data        Json
  userId      String?
  workspaceId String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation("WorkspaceTemplates", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@map("templates")
}

// ─── ActivityLog ────────────────────────────────────────────────────────────

model ActivityLog {
  id         String         @id @default(cuid())
  userId     String
  action     ActivityAction
  entityType EntityType
  entityId   String
  oldData    Json?
  newData    Json?
  taskId     String?
  createdAt  DateTime       @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([taskId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── Notification ──────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?            // { taskId, projectId, commentId, etc. }
  isRead    Boolean          @default(false)
  readAt    DateTime?
  // Watermark: set once a digest email has included this notification, so
  // overlapping daily/weekly windows never email the same item twice
  digestedAt DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─── PushSubscription ──────────────────────────────────────────────────────

model NotificationPreference {
  id             String             @id @default(cuid())
  userId         String             @unique
  emailEnabled   Boolean            @default(true)
  emailFrequency EmailFrequency     @default(daily)
  // Notification types the user has muted (suppressed everywhere: in-app,
  // push and email). REMINDER is deliberately not mutable — reminders are
  // explicitly created by the user per task.
  disabledTypes  NotificationType[] @default([])
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum ApnsEnvironment {
  SANDBOX
  PRODUCTION
}

// An iPhone or iPad the Taskflow app registered for push notifications.
// Tied to the session that registered it: signing that device out stops
// its notifications.
model AppleDevice {
  id          String          @id @default(cuid())
  userId      String
  token       String          @unique
  environment ApnsEnvironment
  sessionId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("apple_devices")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── SyncTombstone ─────────────────────────────────────────────────────────

// A deleted project, section, task or label, written by a trigger so /sync can
// tell clients to drop it. Pruned after 90 days; a client whose cursor is older
// than the pruning floor does a full resync.
model SyncTombstone {
  id         BigInt   @id @default(autoincrement())
  entityType String
  entityId   String
  syncTxid   BigInt   @default(dbgenerated("txid_current()"))
  deletedAt  DateTime @default(now())

  @@index([syncTxid])
  @@map("sync_tombstones")
}

// ─── InstanceSetting ───────────────────────────────────────────────────────

// Deployment-wide settings an admin changes from the console. One row per
// key; a missing row means "use the environment default" (e.g.
// registration_mode falls back to REGISTRATION_MODE).
model InstanceSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("instance_settings")
}
