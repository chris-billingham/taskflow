{
  "name": "@taskflow/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "test": "vitest run src/test/unit src/test/integration",
    "test:unit": "vitest run src/test/unit",
    "test:integration": "vitest run src/test/integration",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "lint": "eslint src --max-warnings 10",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.19.3",
    "@taskflow/contract": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "file-type": "^22.1.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.1",
    "prisma": "^6.19.3",
    "proxy-addr": "^2.0.7",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/proxy-addr": "^2.0.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.2",
    "pino-pretty": "^10.3.1",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
